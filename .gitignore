# Local secrets. Nothing in the pipeline needs a key today (choukai-audio uses
# edge-tts, which has none), but a key committed to git stays valid until it is
# rotated, so the file stays ignored.
.env

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Temporary per-question audio cache (auto-deleted on success anyway)
tests/*/segments/

# PDF text dumps from external-test-import (working cache only)
tests/*/_extract/

# Stage-2 authoring fragments, concatenated into the .md sources at stage 3
# (jlpt-test-generation reading map); the merged Markdown is the deliverable.
tests/*/_sections/

# Compiled helper binaries (tools/vision_ocr.swift is rebuilt on first use)
tools/.build/

# Static GitHub Pages build output (make pages). CI rebuilds it from tests/ on
# every push, so it is a build artifact, never a committed deliverable.
_site/

# Keyless QA renders (make keyless <id> -> qa/<id>/keyless.md) are build
# artifacts, same class as _site/ — but qa/qa-report-<id>.md is a deliverable
# whose open root-cause entries block the next generation run, so it stays
# tracked. Ignore only the per-test render directories.
qa/*/

# Derived 聴解 work order (make findings / make repair-plan). Both are recomputed
# from the gate and the profile in seconds; committing them would be a fourth
# copy of numbers whose single owner is a script (REPORT-CHOUKAI.md §5.0).
logs/findings.json
qa/repair-plan.json
qa/repair-plan.md
